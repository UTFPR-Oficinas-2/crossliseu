# Copy to .env and fill in. Variables marked (required) must be set or the API fails to start.

# --- PostgreSQL ---
# (required)
POSTGRES_DB=
# (required)
POSTGRES_USER=
# (required by the postgres container)
POSTGRES_PASSWORD=
# (required)
POSTGRES_PORT=5432
# (required) "postgres" when the API runs in Docker Compose, "localhost" when it runs on your machine
POSTGRES_HOST=
# (tests only) Database `npm run test:db` drops and recreates on each run; must differ from POSTGRES_DB
POSTGRES_TEST_DB=

# --- API ---
# (required) JWT signing key, e.g. `openssl rand -hex 32`
SECRET=
# WebSocket address arena boxes connect to, written into the generated config.h, e.g. wss://crossliseu.example/arena
ARENA_SERVER_URL=

# --- Admin seed (npm run seed:admin) ---
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
