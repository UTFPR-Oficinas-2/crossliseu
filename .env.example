# Copy to .env and fill in. Variables marked (required) must be set or the API fails to start.

# --- PostgreSQL ---
# (required)
POSTGRES_DB=
# (required)
POSTGRES_USER=
# (required by the postgres container)
POSTGRES_PASSWORD=
# (required)
POSTGRES_PORT=5432
# (required) "postgres" when the API runs in Docker Compose, "localhost" when it runs on your machine
POSTGRES_HOST=
# (tests only) Database `npm run test:db` drops and recreates on each run; must differ from POSTGRES_DB
POSTGRES_TEST_DB=

# --- API ---
# (required) JWT signing key, e.g. `openssl rand -hex 32`
SECRET=
# WebSocket address arena boxes connect to, written into the generated config.h, e.g. wss://crossliseu.example/arena
ARENA_SERVER_URL=

# --- Cloudflare R2 (fight recordings, see docs/recording-storage.md) ---
# The API starts without them; the recording routes answer 503 recording_storage_not_configured
# until all four are set. Ask the account owner for the values; never commit them.
# S3 endpoint of the account, e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# R2 API token (Object Read & Write on the bucket below)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=crossliseu-videos

# --- RabbitMQ (analysis jobs between the API and the CV worker) ---
# Compose defaults both to "crossliseu" in development; set real values in production
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# CV worker mock mode (dev only): process this video instead of each recording, since test
# recordings have no robot markers. The results are NOT from the uploaded video. Uncomment for
# local development; leave it unset or empty (production) to process the real recordings.
# CV_MOCK_VIDEO=/app/data/videos/video_facil.mp4

# --- Admin seed (npm run seed:admin) ---
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
